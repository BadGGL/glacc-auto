# 网页访问密码；必填（为空时容器首次启动会随机生成并打印到日志）
GLACC_PASSWORD=请替换为强随机密码（可用 openssl rand -hex 24）

# 宿主机监听地址与端口
GLACC_BIND=0.0.0.0
GLACC_PORT=8080

# 放在 HTTPS 反代之后时设为 true
GLACC_COOKIE_SECURE=false
# 仅在可信反代之后设为 true；开启后登录限流按真实客户端 IP 计数
GLACC_TRUST_PROXY=false

# 仅构建用：2C1.8G 机器设 1，减少 Rust 编译并发内存峰值
CARGO_BUILD_JOBS=2

# 三个编译期常量不放在这里：构建前 `set -a; . keys/glacc-build.env; set +a`，
# 或使用 `docker compose --env-file keys/glacc-build.env build`。
